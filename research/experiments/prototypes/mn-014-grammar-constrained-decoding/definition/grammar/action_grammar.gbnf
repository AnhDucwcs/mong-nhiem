# Canonical GBNF Action Grammar for MN-014
# Enforces strictly conforming tool interaction for sub-4B models in llama.cpp

root ::= action

action ::= "ACTION: " ( read_action | inspect_action | dispatch_action | resolve_action )

read_action ::= "READ " identifier
inspect_action ::= "INSPECT " identifier "." identifier
dispatch_action ::= "DISPATCH " identifier " " payload
resolve_action ::= "RESOLVE " payload

identifier ::= [a-zA-Z0-9_]+
payload ::= [^\r\n]+
