{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["run_id", "created_at", "experiment", "definition_fingerprint", "repository", "model", "runtime", "hardware", "inference", "selection", "command"],
  "properties": {"run_id": {"type": "string", "pattern": "ecc-003"}, "created_at": {"type": "string", "format": "date-time"}, "experiment": {"type": "object", "required": ["id", "version"], "properties": {"id": {"const": "ecc-003-evidence-position-sensitivity"}, "version": {"const": "0.1.0"}}, "additionalProperties": false}, "definition_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "repository": {"type": "object", "required": ["commit", "dirty"]}, "model": {"type": "object", "required": ["key", "name", "file", "size_bytes", "sha256", "qualified_by"]}, "runtime": {"type": "object", "required": ["backend", "version", "build", "commit", "raw_version_output"]}, "hardware": {"type": "object", "required": ["os", "cpu", "ram_bytes", "gpu", "vram_bytes", "driver", "cuda"]}, "inference": {"type": "object", "required": ["temperature", "seed", "configured_context_size", "output_tokens", "threads", "batch_size", "parallel_slots", "flash_attention", "prompt_cache", "chat_template_kwargs"]}, "selection": {"type": "object", "required": ["context_levels", "evidence_positions", "case_ids", "complete_definition_coverage"]}, "command": {"type": "object", "required": ["server", "runner"]}}, "additionalProperties": false
}
