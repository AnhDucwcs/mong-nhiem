{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object",
  "required": ["case_id", "requested_input_tokens", "requested_evidence_position", "actual_input_tokens", "content_tokens", "prompt_overhead_tokens", "configured_context_size", "output_token_budget", "context_tokens", "evidence_start_token", "evidence_position_ratio", "distractor_pairs", "distractors_before", "distractors_after", "relevant_fact", "expected_answer", "context_sha256", "request", "output", "evaluation", "failure", "truncated", "timing", "error"],
  "properties": {"case_id": {"type": "string", "pattern": "^ecc003-[0-9]{3}$"}, "requested_input_tokens": {"type": "integer", "minimum": 1}, "requested_evidence_position": {"enum": ["early", "middle", "late"]}, "actual_input_tokens": {"type": "integer", "minimum": 1}, "content_tokens": {"type": "integer", "minimum": 1}, "prompt_overhead_tokens": {"type": "integer", "minimum": 0}, "configured_context_size": {"type": "integer", "minimum": 1}, "output_token_budget": {"type": "integer", "minimum": 1}, "context_tokens": {"type": "integer", "minimum": 1}, "evidence_start_token": {"type": "integer", "minimum": 0}, "evidence_position_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "distractor_pairs": {"type": "integer", "minimum": 0}, "distractors_before": {"type": "integer", "minimum": 0}, "distractors_after": {"type": "integer", "minimum": 0}, "relevant_fact": {"type": "string"}, "expected_answer": {"type": "string"}, "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "request": {"type": "object", "required": ["messages", "temperature", "seed", "max_tokens", "chat_template_kwargs"]}, "output": {"type": "object", "required": ["raw_text", "normalized_text", "response"]}, "evaluation": {"type": "object", "required": ["passed", "score"]}, "failure": {"type": ["object", "null"]}, "truncated": {"type": "boolean"}, "timing": {"type": "object", "required": ["total_ms"]}, "error": {"type": ["object", "null"]}}, "additionalProperties": false
}
