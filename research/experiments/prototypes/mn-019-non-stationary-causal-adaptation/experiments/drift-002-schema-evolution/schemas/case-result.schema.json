{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage 2 Case Result Schema",
  "type": "object",
  "required": [
    "case_id",
    "domain",
    "difficulty",
    "arm",
    "is_success",
    "turns_executed",
    "subgoals_completed",
    "committed_schema_violations",
    "committed_conservation_breaches",
    "compaction_ratio",
    "max_prompt_tokens",
    "mean_prompt_tokens",
    "mean_latency_ms"
  ],
  "properties": {
    "case_id": {"type": "string"},
    "domain": {"type": "string"},
    "difficulty": {"type": "string", "enum": ["in_distribution", "out_of_distribution"]},
    "arm": {"type": "string"},
    "is_success": {"type": "boolean"},
    "turns_executed": {"type": "integer"},
    "subgoals_completed": {"type": "integer"},
    "total_subgoals": {"type": "integer"},
    "committed_schema_violations": {"type": "integer"},
    "committed_conservation_breaches": {"type": "integer"},
    "compaction_ratio": {"type": "number"},
    "max_prompt_tokens": {"type": "integer"},
    "mean_prompt_tokens": {"type": "number"},
    "mean_latency_ms": {"type": "number"},
    "emerged_entities": {"type": "array", "items": {"type": "string"}},
    "retired_entities": {"type": "array", "items": {"type": "string"}}
  }
}
